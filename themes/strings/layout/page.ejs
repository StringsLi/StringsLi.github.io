<% const isSearch = page.path === 'search/index.html'; const isCategories = page.path === 'categories/index.html'; const isTags = page.path === 'tags/index.html'; const isArchives = page.path === 'archives/index.html'; %>
<section class="page wrap-narrow reveal"><header class="page-header"><p class="eyebrow">STRINGS / <%= page.title %></p><h1><%= page.title %></h1></header><% if (isSearch) { %><%- partial('_partial/search') %><% } else if (isCategories) { %><div class="taxonomy-grid"><%- list_categories({ show_count: true, class: 'taxonomy-list' }) %></div><% } else if (isTags) { %><div class="taxonomy-grid tags"><%- list_tags({ show_count: true, class: 'taxonomy-list' }) %></div><% } else if (isArchives) { %><%- partial('_partial/archive-list', { posts: site.posts }) %><% } else { %><div class="post-content page-content"><%- page.content %></div><% } %></section>
