<div class="archive-list"><% posts.sort('-date').each(function(post) { const displayTitle = post.title || post.slug || post.source.replace(/^_posts\//, '').replace(/\.md$/, ''); %><article><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time><a href="<%- url_for(post.path) %>"><%= displayTitle %></a><% if (post.categories.length) { %><span><%- list_categories(post.categories, { show_count: false }) %></span><% } %></article><% }) %></div>