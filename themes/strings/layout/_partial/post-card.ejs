<% const displayTitle = post.title || post.slug || post.source.replace(/^_posts\//, '').replace(/\.md$/, ''); %>
<article class="post-card reveal"><p class="post-card-meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, config.date_format) %></time><% if (post.categories.length) { %><span>·</span><%- list_categories(post.categories, { show_count: false, class: 'inline-taxonomy' }) %><% } %></p><h3><a href="<%- url_for(post.path) %>"><%= displayTitle %></a></h3><p class="post-excerpt"><%= strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').slice(0, 150) %><%= strip_html(post.content).length > 150 ? '…' : '' %></p><a class="read-link" href="<%- url_for(post.path) %>">继续阅读 <span>→</span></a></article>