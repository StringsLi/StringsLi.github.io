<header class="site-header"><div class="header-inner wrap"><a class="wordmark" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页"><span>S</span><%= config.title %></a><button class="nav-toggle" type="button" aria-label="切换导航" aria-expanded="false">菜单</button><nav class="site-nav" aria-label="主导航"><% theme.menu.forEach(function(item) { %><a class="<%= is_current(item.url) ? 'active' : '' %>" href="<%- url_for(item.url) %>"><%= item.name %></a><% }) %><button class="theme-toggle" type="button" aria-label="切换深色模式">◐</button></nav></div></header>
